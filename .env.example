# Neon Postgres Pooled connection string (used at runtime)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres Direct connection string (used for migrations: prisma migrate deploy / dev)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret key used to sign and verify httpOnly session JWT tokens (min 32 characters)
SESSION_SECRET="super-secret-session-key-min-32-chars-long-ajaia-takehome"

